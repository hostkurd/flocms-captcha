{
  "name": "hostkurd/flocms-captcha",
  "description": "Image captcha package for FloCMS guest form verification.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "flocms",
    "captcha",
    "form",
    "security",
    "verification"
  ],
  "require": {
    "php": ">=8.1",
    "ext-gd": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "FloCMS\\Captcha\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FloCMS\\Captcha\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "HostKurd"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true
}
